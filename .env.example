# Deployment configuration. Copied to .env (untracked) and loaded by every
# Makefile and scripts/*.sh. Blank values here are required and must be filled in.

# AWS
AWS_REGION=ap-southeast-2
# Must be an AZ in AWS_REGION that supports the instance types used.
AVAILABILITY_ZONE=ap-southeast-2b

# Arm64 host AMI for the rads executor and the secure-rads enclave host.
# Any current Amazon Linux 2023 arm64 AMI works, for example:
#   aws ssm get-parameter --name /aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-arm64 \
#     --region "$AWS_REGION" --query Parameter.Value --output text
RADS_EXECUTOR_AMI_ID=
SCE_ENCLAVE_AMI_ID=

# CloudFront certificates, must be issued in us-east-1.
CERT_ARN_RADS=
CERT_ARN_SECURE_RADS=

# Public hostnames
TRANSPARENCY_DOMAIN_RADS=transparency.r.secure-rads.org
TRANSPARENCY_DOMAIN_SECURE_RADS=transparency.sr.secure-rads.org
LOG_HOST_RADS=log.r.secure-rads.org
LOG_HOST_SECURE_RADS=log.sr.secure-rads.org
COST_HOST_RADS=cost.r.secure-rads.org
COST_HOST_SECURE_RADS=cost.sr.secure-rads.org
PDM_HOST=pdm.sr.secure-rads.org
KMS_HOST=kms.sr.secure-rads.org
VERIFIER_HOST=verifier.sr.secure-rads.org
VERIFIER_ATTEST_HOST=verifier-attest.sr.secure-rads.org
VERIFIER_URL=https://verifier.sr.secure-rads.org/algorithms

# TLS public-key pins (SHA-256) for the endpoints the enclave and registry-service contact.
# `make env` fills these from the live endpoints.
VERIFIER_PUBKEY_SHA256=
VERIFIER_HOST_PUBKEY_SHA256=
PDM_HOST_PUBKEY_SHA256=
KMS_HOST_PUBKEY_SHA256=
LOG_HOST_PUBKEY_SHA256=
VERIFIER_JWKS_URL=https://verifier-attest.sr.secure-rads.org/.well-known/jwks.json
# SHA-256 of the verifier JWKS public key, printed by the verifier-service deploy.
# Used by pdm-service and log-service to verify attested access tokens.
VERIFIER_JWKS_PUBKEY_SHA256=

# Cloudflare
CLOUDFLARE_ZONE=secure-rads.org
CLOUDFLARE_EMAIL=REPLACE_WITH_CLOUDFLARE_ACCOUNT_EMAIL
CLOUDFLARE_API_TOKEN=REPLACE_WITH_CLOUDFLARE_GLOBAL_API_KEY
