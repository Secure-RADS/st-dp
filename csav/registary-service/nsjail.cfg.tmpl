# Runs the Data Controller's app inside its own rootfs with no network
# namespace access (matches the "DC app gets no network" privilege boundary).
# There's no dedicated "chroot" field in nsjail's config - the rootfs
# replaces "/" via a bind mount instead.
#
# Generated per-build: exec_bin below comes from the uploaded image's own
# ENTRYPOINT/CMD, not a hardcoded guess - there's no universal binary path
# across arbitrary Data Controller images.
#
# Locked down as tightly as this sandbox allows: real user-namespace
# isolation (not just cap-dropping in the same namespace), no loopback, no
# suid/dev on any mount, and a seccomp denylist on top of the namespace/rlimit
# restrictions.
#
# The DC app and the SCE Unit share /run/sce as a unix-socket directory.
# nsjail's mounts are set up before the DC app starts, so it can't bind a
# socket file that doesn't exist yet - bind-mounting the directory instead
# means the socket file the DC app creates once it's running becomes visible
# on both sides (same underlying directory, just two mount-namespace views
# of it): /opt/controller/rootfs/run/sce outside the jail, /run/sce inside.

name: "controller-jail"

hostname: "dc-app"

iface_no_lo: true

mount_proc: true

# nsjail strips the environment by default (keep_env: false) - without this,
# a jailed app's own PATH-relying subprocess calls silently fail. Sourced
# from the DC's own image (not guessed) - see pathFromEnv in build.go.
envar: "PATH={{.PathEnv}}"

rlimit_as: 2048
rlimit_cpu: 3600
rlimit_fsize: 1024
rlimit_nofile: 64
rlimit_nproc: 16

mount {
	src: "/opt/controller/rootfs"
	dst: "/"
	is_bind: true
	is_dir: true
	rw: true
	nosuid: true
	nodev: true
}

mount {
	dst: "/tmp"
	fstype: "tmpfs"
	rw: true
	nosuid: true
	nodev: true
}

mount {
	src: "/opt/controller/rootfs/run/sce"
	dst: "/run/sce"
	is_bind: true
	is_dir: true
	rw: true
	nosuid: true
	nodev: true
}

seccomp_string: "KILL_PROCESS {"
seccomp_string: "	ptrace,"
seccomp_string: "	process_vm_readv,"
seccomp_string: "	process_vm_writev,"
seccomp_string: "	mount,"
seccomp_string: "	reboot,"
seccomp_string: "	init_module,"
seccomp_string: "	delete_module,"
seccomp_string: "	acct"
seccomp_string: "}"
seccomp_string: "DEFAULT ALLOW"

exec_bin {
	path: {{printf "%q" .Path}}
{{- range .Args}}
	arg: {{printf "%q" .}}
{{- end}}
}
