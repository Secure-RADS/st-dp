AWSTemplateFormatVersion: "2010-09-09"
Description: >
  CSAV stack: EC2 instance running the CSAV module.

Parameters:
  InstanceType:
    Type: String
    Default: t4g.small
    Description: EC2 instance type for the CSAV instance. t4g.nano's 0.5GB RAM can't handle composing real-sized images (OOM/swap thrashing) - t4g.small (2GB) is the smallest step up that comfortably does.

  KeyName:
    Type: AWS::EC2::KeyPair::KeyName
    Description: EC2 key pair for SSH access.

  AppPort:
    Type: Number
    Default: 8080
    Description: Port the registry-service app listens on, exposed publicly.

  VpcId:
    Type: AWS::EC2::VPC::Id
    Description: VPC to launch the CSAV instance in (the account's default VPC).

  ArtifactBucketName:
    Type: String
    Description: Name of the registry-service artifact bucket (from the secure-rads-registry-service-storage stack), for the instance's S3 write permission.

  AlgorithmTableName:
    Type: String
    Description: Name of the registry-service AlgorithmId->S3 path table (from the secure-rads-registry-service-storage stack), for the instance's DynamoDB write permission.

  LatestAmiId:
    Type: AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>
    Default: /aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-arm64

Resources:
  CsavSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for the CSAV instance.
      VpcId: !Ref VpcId
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 22
          ToPort: 22
          CidrIp: 0.0.0.0/0
        - IpProtocol: tcp
          FromPort: !Ref AppPort
          ToPort: !Ref AppPort
          CidrIp: 0.0.0.0/0
      SecurityGroupEgress:
        - IpProtocol: "-1"
          CidrIp: 0.0.0.0/0

  CsavInstanceRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal:
              Service: ec2.amazonaws.com
            Action: sts:AssumeRole
      Policies:
        - PolicyName: ArtifactBucketWrite
          PolicyDocument:
            Version: "2012-10-17"
            Statement:
              - Effect: Allow
                Action: s3:PutObject
                Resource: !Sub "arn:aws:s3:::${ArtifactBucketName}/*"
        # The CSAV builds one PCR-bound KMS key per algorithm (registry-service provisions it after the EIF
        # build, when the measurements are known) and reuses it on rebuild, rewriting the policy. CreateKey is a
        # management call with no key resource; Get/PutKeyPolicy act on the algorithm's own key.
        - PolicyName: KmsProvisionAlgorithmKeys
          PolicyDocument:
            Version: "2012-10-17"
            Statement:
              - Effect: Allow
                Action: [kms:CreateKey, kms:ListKeys, kms:DescribeKey, kms:GetKeyPolicy, kms:PutKeyPolicy]
                Resource: "*"
        - PolicyName: AlgorithmTableWrite
          PolicyDocument:
            Version: "2012-10-17"
            Statement:
              - Effect: Allow
                Action: [dynamodb:PutItem, dynamodb:GetItem]
                Resource: !Sub "arn:aws:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${AlgorithmTableName}"

  CsavInstanceProfile:
    Type: AWS::IAM::InstanceProfile
    Properties:
      Roles:
        - !Ref CsavInstanceRole

  CsavInstance:
    Type: AWS::EC2::Instance
    Properties:
      InstanceType: !Ref InstanceType
      ImageId: !Ref LatestAmiId
      KeyName: !Ref KeyName
      IamInstanceProfile: !Ref CsavInstanceProfile
      SecurityGroupIds:
        - !Ref CsavSecurityGroup
      MetadataOptions:
        HttpPutResponseHopLimit: 2
      UserData:
        Fn::Base64: |
          @@USERDATA@@
      Tags:
        - Key: Name
          Value: secure-rads-csav

Outputs:
  CsavInstanceId:
    Value: !Ref CsavInstance

  CsavInstancePublicIp:
    Value: !GetAtt CsavInstance.PublicIp

  CsavInstanceRoleArn:
    Value: !GetAtt CsavInstanceRole.Arn
