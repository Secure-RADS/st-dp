# No "chroot" field - the DC's rootfs replaces "/" via a bind mount instead.
# exec_bin is generated per-build from the uploaded image's own
# ENTRYPOINT/CMD - no universal binary path across arbitrary DC images.
#
# The DC app pulls records and submits its result over the gRPC socket
# sce-unit serves at /data/sce.sock inside the jail (see sce-unit/rpc.go).

name: "data-controller-application-jail"

hostname: "dc-app"

iface_no_lo: true

mount_proc: true

# nsjail strips env vars by default; PATH here is sourced from the DC's own image (see pathFromEnv in oci.go).
envar: "PATH={{.PathEnv}}"
envar: "SCE_RPC_SOCKET=/data/sce.sock"
envar: "ALGORITHM_ID={{.AlgorithmId}}"
# Without HOME, glibc NSS calls getpwuid for ~ expansion.
envar: "HOME=/data"

# rlimits left deliberately loose — lockdown is the seccomp allowlist below (see csav/README.md).
# fsize raised so app scratch files (size sweeps) fit on disk inside the jail.
rlimit_as: 2048
rlimit_cpu: 3600
rlimit_fsize: 8192
rlimit_nofile: 64
rlimit_nproc: 16

mount {
	src: "/opt/dc-app/rootfs"
	dst: "/"
	is_bind: true
	is_dir: true
	rw: true
	nosuid: true
	nodev: true
}

mount {
	dst: "/tmp"
	fstype: "tmpfs"
	rw: true
	nosuid: true
	nodev: true
}

# Allowlist for the shipped samples: file I/O, process control, and AF_UNIX
# sockets for the sce-unit gRPC channel. The jail stays loopback-free.
seccomp_string: "ALLOW {"
seccomp_string: "	read, write, close, lseek, pread64, pwrite64, readv, writev,"
seccomp_string: "	openat, openat2, newfstatat, newfstat, statx, getdents64, faccessat, faccessat2,"
seccomp_string: "	readlinkat, unlinkat, mkdirat, renameat, renameat2, ftruncate, fsync, fdatasync,"
seccomp_string: "	fchmodat, utimensat, statfs, fstatfs,"
seccomp_string: "	mmap, mprotect, munmap, madvise, mremap, brk,"
seccomp_string: "	rt_sigaction, rt_sigprocmask, rt_sigreturn, rt_sigtimedwait, sigaltstack,"
seccomp_string: "	futex, set_robust_list, set_tid_address, rseq, membarrier,"
seccomp_string: "	clone, clone3, exit, exit_group, wait4, waitid, tgkill, kill,"
seccomp_string: "	execve, execveat,"
seccomp_string: "	getpid, gettid, getppid, getuid, geteuid, getgid, getegid, getgroups,"
seccomp_string: "	getcwd, ioctl, fcntl, pipe2, dup, dup3,"
seccomp_string: "	gettimeofday, clock_gettime, clock_nanosleep, nanosleep, getrandom,"
seccomp_string: "	prctl, prlimit64, getrlimit, newuname, sysinfo, sched_yield, sched_getaffinity,"
seccomp_string: "	epoll_create1, epoll_ctl, epoll_pwait, epoll_pwait2, ppoll, pselect6,"
seccomp_string: "	socket, socketpair, connect, bind, listen, accept, accept4,"
seccomp_string: "	sendto, recvfrom, sendmsg, recvmsg, shutdown, getsockopt, setsockopt,"
seccomp_string: "	getpeername, getsockname,"
seccomp_string: "	eventfd2"
seccomp_string: "}"
seccomp_string: "DEFAULT KILL_PROCESS"

exec_bin {
	path: {{printf "%q" .Path}}
{{- range .Args}}
	arg: {{printf "%q" .}}
{{- end}}
}
