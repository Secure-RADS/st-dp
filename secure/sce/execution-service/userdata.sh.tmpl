#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/execution-service-run.log) 2>&1

# Fetched once so both the per-run config server (port 5001) and the exit trap can use it.
IMDS_TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600" || true)
INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/instance-id || true)
REGION=$(curl -s -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/placement/region || true)

emit_event() {
  curl -sS --max-time 5 -X POST "https://{{.LogHost}}/events" -H 'content-type: application/json' \
    -d "{\"algorithmId\":\"{{.AlgorithmId}}\",\"runId\":\"{{.RunId}}\",\"event\":\"$1\",\"timestamp\":\"$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)\"}" >/dev/null || true
}

# Cost metering reports selected AWS operations, keyed by (AlgorithmId, runId). Best-effort.
emit_cost() {
  [ -z "{{.CostHost}}" ] && return 0
  curl -sS --fail --max-time 5 -X POST "https://{{.CostHost}}/cost" -H 'content-type: application/json' \
    -d "{\"algorithmId\":\"{{.AlgorithmId}}\",\"runId\":\"{{.RunId}}\",\"eventId\":\"$(cat /proc/sys/kernel/random/uuid)\",\"phase\":\"execution\",\"service\":\"$1\",\"operation\":\"$2\",\"quantity\":$3,\"timestamp\":\"$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)\"}" >/dev/null || true
}

# Always self-terminate on exit. The enclave publishes the run result to SQS itself; the host only relays
# a completion signal carrying the result byte count (for cost metering) and then terminates.
finish() {
  set +e
  RESULT_BYTES=$(python3 -c 'import json; print(json.load(open("/tmp/result-meta.json")).get("resultBytes", 0))' 2>/dev/null || echo 0)
  emit_event executor-finished
  if [ "${RESULT_BYTES:-0}" -gt 0 ]; then
    emit_cost sqs send "$RESULT_BYTES"
  fi
  # The runtime estimate is captured before this cost POST and the terminate request.
  emit_cost ec2 instance "$(( $(date +%s) - {{.LaunchEpoch}} ))"
  aws ec2 terminate-instances --instance-ids "$INSTANCE_ID" --region "$REGION"
}
trap finish EXIT

# Pinned to match eif-build/Dockerfile - version mismatch fails the boot handshake silently.
dnf install -y aws-nitro-enclaves-cli-1.4.4-0.amzn2023 aws-nitro-enclaves-cli-devel-1.4.4-0.amzn2023 awscli

cat > /etc/nitro_enclaves/allocator.yaml <<EOF
---
memory_mib: {{.MemoryMiB}}
cpu_count: {{.CPUCount}}
EOF
systemctl enable --now nitro-enclaves-allocator

# Checkpoint: the host is provisioned (boot + nitro tooling), before the artifact is pulled.
emit_event executor-ready

mkdir -p /opt/eif
aws s3 cp "s3://{{.S3Bucket}}/{{.S3Key}}" /opt/eif/app.eif --region "{{.Region}}"
emit_cost s3 get 1

# Checkpoint: the algorithm artifact (EIF) is now on the host, before the enclave is launched.
emit_event artifact-retrieved

# The enclave signals completion (with the result byte count) on this port; the result itself goes to SQS
# from inside the enclave, never across this channel.
python3 - <<'PYEOF' &
import socket
s = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
s.settimeout(3600)
s.bind((socket.VMADDR_CID_ANY, 5000))
s.listen(1)
conn, _ = s.accept()
conn.settimeout(3600)
with open("/tmp/result-meta.json", "wb") as f:
    while chunk := conn.recv(65536):
        f.write(chunk)
PYEOF
OUTPUT_LISTENER_PID=$!

# Serve this run's id, record limit, instance id, and results queue URL to the enclave on port 5001 - the
# enclave takes no user-data, so it has no other way to learn them (the EIF carries per-algorithm config).
INSTANCE_ID="$INSTANCE_ID" QUEUE_URL="{{.QueueUrl}}" python3 - <<'PYEOF' &
import json, os, socket
s = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind((socket.VMADDR_CID_ANY, 5001))
s.listen(5)
body = json.dumps({
    "runId": "{{.RunId}}",
    "size": {{.Size}},
    "instanceId": os.environ["INSTANCE_ID"],
    "queueUrl": os.environ["QUEUE_URL"],
}).encode()
while True:
    conn, _ = s.accept()
    conn.sendall(body)
    conn.close()
PYEOF

# Serve fresh IMDSv2 role credentials to the enclave on port 5002 so it can call KMS. The enclave has no
# IMDS access; the host holds the role. KMS's attestation-condition key policy is what stops the host from
# using these credentials to decrypt the data keys on its own.
python3 - <<'PYEOF' &
import json, socket, urllib.request
def get(path, token=None):
    req = urllib.request.Request("http://169.254.169.254"+path)
    if token:
        req.add_header("X-aws-ec2-metadata-token", token)
    return urllib.request.urlopen(req, timeout=5).read().decode()
token = urllib.request.urlopen(urllib.request.Request("http://169.254.169.254/latest/api/token",
    data=b"", method="PUT", headers={"X-aws-ec2-metadata-token-ttl-seconds": "21600"}), timeout=5).read().decode()
role = get("/latest/meta-data/iam/security-credentials/", token)
creds = json.loads(get("/latest/meta-data/iam/security-credentials/"+role, token))
body = json.dumps({
    "accessKeyId": creds["AccessKeyId"],
    "secretAccessKey": creds["SecretAccessKey"],
    "sessionToken": creds["Token"],
}).encode()
s = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind((socket.VMADDR_CID_ANY, 5002))
s.listen(5)
while True:
    conn, _ = s.accept()
    conn.sendall(body)
    conn.close()
PYEOF

# Only way out of the enclave: one vsock-proxy per allowed host forwards vsock traffic over real TCP/TLS, resolving DNS here since the enclave has none.
cat > /etc/nitro_enclaves/vsock-proxy.yaml <<EOF
allowlist:
  - {address: "{{.VerifierHost}}", port: 443}
  - {address: "{{.PdmHost}}", port: 443}
  - {address: "{{.LogHost}}", port: 443}
  - {address: "kms.{{.Region}}.amazonaws.com", port: 443}
  - {address: "sqs.{{.Region}}.amazonaws.com", port: 443}
EOF
vsock-proxy 8000 "kms.{{.Region}}.amazonaws.com" 443 --config /etc/nitro_enclaves/vsock-proxy.yaml &
vsock-proxy 8004 "sqs.{{.Region}}.amazonaws.com" 443 --config /etc/nitro_enclaves/vsock-proxy.yaml &
vsock-proxy 8001 "{{.VerifierHost}}" 443 --config /etc/nitro_enclaves/vsock-proxy.yaml &
vsock-proxy 8002 "{{.PdmHost}}" 443 --config /etc/nitro_enclaves/vsock-proxy.yaml &
vsock-proxy 8003 "{{.LogHost}}" 443 --config /etc/nitro_enclaves/vsock-proxy.yaml &

# run-enclave can transiently fail right after the allocator starts (hugepages not yet reserved) - retry.
launched=false
for attempt in 1 2 3 4 5; do
  if nitro-cli run-enclave --cpu-count {{.CPUCount}} --memory {{.MemoryMiB}} --eif-path /opt/eif/app.eif --enclave-cid 16 >> /tmp/run-enclave.log 2>&1; then
    launched=true
    break
  fi
  echo "run-enclave attempt $attempt failed, retrying" >> /tmp/run-enclave.log
  sleep 5
done

if [ "$launched" = true ]; then
  emit_event enclave-launched
  # Wait for output first so a transient describe-enclaves miss cannot publish an empty result.
  wait "$OUTPUT_LISTENER_PID" || exit $?
  while true; do
    ENCLAVE_COUNT=$(nitro-cli describe-enclaves | python3 -c 'import json, sys; print(sum(e.get("EnclaveCID") == 16 for e in json.load(sys.stdin)))') || exit 1
    [ "$ENCLAVE_COUNT" -eq 0 ] && break
    sleep 1
  done
else
  kill "$OUTPUT_LISTENER_PID" 2>/dev/null || true
  wait "$OUTPUT_LISTENER_PID" 2>/dev/null || true
  exit 1
fi
