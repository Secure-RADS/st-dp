#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/execution-service-run.log) 2>&1

# The host has no attested token, so these events are posted directly and log-service records them as
# auth=none, origin=host. The enclave owns the post-attestation and terminal events.
emit_event() {
  curl -sS --max-time 5 -X POST "https://{{.TelemetryHost}}/events" -H 'content-type: application/json' \
    -d "{\"algorithmId\":\"{{.AlgorithmId}}\",\"runId\":\"{{.RunId}}\",\"event\":\"$1\",\"timestamp\":\"$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)\",\"origin\":\"host\"}" >/dev/null || true
}

# Cost metering reports selected AWS operations, keyed by (AlgorithmId, runId). Best-effort.
emit_cost() {
  [ -z "{{.CostHost}}" ] && return 0
  curl -sS --fail --max-time 5 -X POST "https://{{.CostHost}}/cost" -H 'content-type: application/json' \
    -d "{\"algorithmId\":\"{{.AlgorithmId}}\",\"runId\":\"{{.RunId}}\",\"eventId\":\"$(cat /proc/sys/kernel/random/uuid)\",\"phase\":\"execution\",\"service\":\"$1\",\"operation\":\"$2\",\"quantity\":$3,\"timestamp\":\"$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)\"}" >/dev/null || true
}

# Always self-terminate on exit and send the run result to SQS, where a consumer Lambda persists it for the
# caller to poll (GET /run/<runId>). The result carries the runId execution-service assigned at launch.
finish() {
  STATUS=$?
  set +e
  TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")
  INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
  REGION=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/region)
  python3 - "$STATUS" "$INSTANCE_ID" > /tmp/result.json <<'PYEOF'
import json, sys
def read(path):
    try:
        return open(path, "rb").read().decode("utf-8", "replace")
    except FileNotFoundError:
        return ""
out = read("/tmp/output.txt")
# When the DC app produced no output, surface the enclave launch log so an empty result is diagnosable
# instead of silent (the enclave console is otherwise lost when the host terminates).
diag = {"runEnclave": read("/tmp/run-enclave.log")} if not out else {}
print(json.dumps({"runId": "{{.RunId}}", "algorithmId": "{{.AlgorithmId}}", "instanceId": sys.argv[2], "status": "exit:" + sys.argv[1], "output": out, "diag": diag}))
PYEOF
  aws sqs send-message --queue-url "{{.QueueUrl}}" --message-body file:///tmp/result.json --region "$REGION" || true
  emit_event executor-finished
  emit_cost sqs send "$(wc -c < /tmp/result.json)"
  # The runtime estimate is captured before this cost POST and the terminate request.
  emit_cost ec2 instance "$(( $(date +%s) - {{.LaunchEpoch}} ))"
  aws ec2 terminate-instances --instance-ids "$INSTANCE_ID" --region "$REGION"
}
trap finish EXIT

# Pinned to match eif-build/Dockerfile - version mismatch fails the boot handshake silently.
dnf install -y aws-nitro-enclaves-cli-1.4.4-0.amzn2023 aws-nitro-enclaves-cli-devel-1.4.4-0.amzn2023 awscli

cat > /etc/nitro_enclaves/allocator.yaml <<EOF
---
memory_mib: {{.MemoryMiB}}
cpu_count: {{.CPUCount}}
EOF
systemctl enable --now nitro-enclaves-allocator

# Checkpoint: the host is provisioned (boot + nitro tooling), before the artifact is pulled.
emit_event executor-ready

mkdir -p /opt/eif
aws s3 cp "s3://{{.S3Bucket}}/{{.S3Key}}" /opt/eif/app.eif --region "{{.Region}}"
emit_cost s3 get 1

# Checkpoint: the algorithm artifact (EIF) is now on the host, before the enclave is launched.
emit_event artifact-retrieved

# sce-unit connects back to the parent (CID 3) on port 5000 and streams the DC app's output; one connection per run.
python3 - <<'PYEOF' &
import socket
s = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
s.settimeout(3600)
s.bind((socket.VMADDR_CID_ANY, 5000))
s.listen(1)
conn, _ = s.accept()
conn.settimeout(3600)
with open("/tmp/output.txt", "wb") as f:
    while chunk := conn.recv(65536):
        f.write(chunk)
PYEOF
OUTPUT_LISTENER_PID=$!

# Serve this run's id and record limit to the enclave on port 5001 - the enclave takes no user-data, so it
# has no other way to learn the per-run id or how many records to read (the EIF carries per-algorithm config).
python3 - <<'PYEOF' &
import json, socket
s = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind((socket.VMADDR_CID_ANY, 5001))
s.listen(5)
body = json.dumps({"runId": "{{.RunId}}", "size": {{.Size}}}).encode()
while True:
    conn, _ = s.accept()
    conn.sendall(body)
    conn.close()
PYEOF

# Only way out of the enclave: one vsock-proxy per allowed host forwards vsock traffic over real TCP/TLS, resolving DNS here since the enclave has none.
cat > /etc/nitro_enclaves/vsock-proxy.yaml <<EOF
allowlist:
  - {address: "{{.VerifierHost}}", port: 443}
  - {address: "{{.PdmHost}}", port: 443}
  - {address: "{{.LogHost}}", port: 443}
  - {address: "{{.TelemetryHost}}", port: 443}
  - {address: "{{.KmsHost}}", port: 443}
EOF
vsock-proxy 8000 "{{.KmsHost}}" 443 --config /etc/nitro_enclaves/vsock-proxy.yaml &
vsock-proxy 8001 "{{.VerifierHost}}" 443 --config /etc/nitro_enclaves/vsock-proxy.yaml &
vsock-proxy 8002 "{{.PdmHost}}" 443 --config /etc/nitro_enclaves/vsock-proxy.yaml &
vsock-proxy 8003 "{{.LogHost}}" 443 --config /etc/nitro_enclaves/vsock-proxy.yaml &
vsock-proxy 8004 "{{.TelemetryHost}}" 443 --config /etc/nitro_enclaves/vsock-proxy.yaml &

# run-enclave can transiently fail right after the allocator starts (hugepages not yet reserved) - retry.
launched=false
for attempt in 1 2 3 4 5; do
  if nitro-cli run-enclave --cpu-count {{.CPUCount}} --memory {{.MemoryMiB}} --eif-path /opt/eif/app.eif --enclave-cid 16 >> /tmp/run-enclave.log 2>&1; then
    launched=true
    break
  fi
  echo "run-enclave attempt $attempt failed, retrying" >> /tmp/run-enclave.log
  sleep 5
done

if [ "$launched" = true ]; then
  emit_event enclave-launched
  # The listener exits on vsock EOF once the enclave has sent its output. Everything the enclave still does
  # after that (teardown) is not part of result delivery, so stop waiting here.
  wait "$OUTPUT_LISTENER_PID" || exit $?
  emit_event output-received
else
  kill "$OUTPUT_LISTENER_PID" 2>/dev/null || true
  wait "$OUTPUT_LISTENER_PID" 2>/dev/null || true
  exit 1
fi
