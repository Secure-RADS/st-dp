#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/rads-execution-service-run.log) 2>&1

# Cost metering reports selected AWS operations, keyed by (AlgorithmId, runId). Best-effort.
emit_cost() {
  [ -z "{{.CostHost}}" ] && return 0
  curl -sS --fail --max-time 5 -X POST "https://{{.CostHost}}/cost" -H 'content-type: application/json' \
    -d "{\"algorithmId\":\"{{.AlgorithmId}}\",\"runId\":\"{{.RunId}}\",\"eventId\":\"$(cat /proc/sys/kernel/random/uuid)\",\"phase\":\"execution\",\"service\":\"$1\",\"operation\":\"$2\",\"quantity\":$3,\"timestamp\":\"$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)\"}" >/dev/null || true
}

# Per-run plain Docker executor; the host owns the data path and result delivery.
RUN_ID="{{.RunId}}"
ALGORITHM_ID="{{.AlgorithmId}}"
S3_BUCKET="{{.S3Bucket}}"
S3_KEY="{{.S3Key}}"
REGION="{{.Region}}"
PDM_URL="{{.PdmUrl}}"
RUN_RESULTS_QUEUE="{{.RunResultsQueueUrl}}"
LOG_HOST="{{.LogHost}}"
TELEMETRY_HOST="{{.TelemetryHost}}"
# Record count for this run; empty means the whole dataset.
SIZE="{{.Size}}"
# Fixed key in the images bucket; make ship uploads the linux/arm64 helper binary here.
TOOLS_S3_KEY="executor/rads-host-tools"
TOOLS_BIN=/opt/rads/bin/rads-host-tools

# Host paths, bind-mounted into the container at /data.
RUN_DIR=/opt/rads/run
RECORDS_FILE="$RUN_DIR/records.json"
RESULT_FILE="$RUN_DIR/result.json"
OUTPUT_FILE="$RUN_DIR/output.txt"
DOCKER_LOAD_LOG="$RUN_DIR/docker-load.log"

# Emit one run-timeline checkpoint via log-service HTTP (same path as secure-rads). Best-effort.
emit_event() {
  "$TOOLS_BIN" checkpoint "$ALGORITHM_ID" "$RUN_ID" "$1" > /tmp/checkpoint.json
  curl -sS -X POST "https://$TELEMETRY_HOST/events" -H 'content-type: application/json' \
    -d @/tmp/checkpoint.json >/dev/null || true
}

# Publish the run outcome, log the terminal event, and terminate the instance.
finish() {
  STATUS=$?
  set +e
  TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")
  INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
  "$TOOLS_BIN" run-result "$STATUS" "$INSTANCE_ID" "$RESULT_FILE" "$OUTPUT_FILE" "$DOCKER_LOAD_LOG" "$RUN_ID" "$ALGORITHM_ID" > /tmp/result.json
  aws sqs send-message --queue-url "$RUN_RESULTS_QUEUE" --message-body file:///tmp/result.json --region "$REGION" || true
  "$TOOLS_BIN" executor-finished "$STATUS" "$INSTANCE_ID" "$ALGORITHM_ID" "$RUN_ID" > /tmp/log-event.json
  curl -sS -X POST "https://$TELEMETRY_HOST/events" -H 'content-type: application/json' \
    -d @/tmp/log-event.json >/dev/null || true
  emit_cost sqs send "$(wc -c < /tmp/result.json)"
  # The runtime estimate is captured before this cost POST and the terminate request.
  emit_cost ec2 instance "$(( $(date +%s) - {{.LaunchEpoch}} ))"
  aws ec2 terminate-instances --instance-ids "$INSTANCE_ID" --region "$REGION" || true
}
trap finish EXIT

# Docker on Amazon Linux 2023; awscli covers the S3 pull and results SQS publish.
dnf install -y docker awscli >/dev/null
systemctl enable --now docker
for attempt in 1 2 3 4 5 6; do docker info >/dev/null 2>&1 && break; sleep 5; done

# Pull host helpers before executor-ready so the download sits in host provisioning, not data retrieval.
mkdir -p /opt/rads/bin "$RUN_DIR"
aws s3 cp "s3://$S3_BUCKET/$TOOLS_S3_KEY" "$TOOLS_BIN" --region "$REGION"
chmod +x "$TOOLS_BIN"
emit_cost s3 get 1
emit_event executor-ready

# Pull the algorithm artifact first, so the run steps follow the same order as secure-rads (artifact, data, compute).
aws s3 cp "s3://$S3_BUCKET/$S3_KEY" /tmp/app.tar --region "$REGION"
emit_cost s3 get 1
docker load < /tmp/app.tar > "$DOCKER_LOAD_LOG"
IMAGE=$(tail -n 1 "$DOCKER_LOAD_LOG" | sed -n 's/^Loaded image: //p')
if [ -z "$IMAGE" ]; then
  echo "could not determine loaded image" >&2
  exit 1
fi
emit_event artifact-retrieved

# Download the algorithm's full record set before the app starts, so the DC app reads a local file.
SUBJECT_IDS=$("$TOOLS_BIN" fetch-records "$PDM_URL" "$ALGORITHM_ID" "$RECORDS_FILE" "$RUN_ID" "$SIZE" "https://$TELEMETRY_HOST/events") || exit $?
emit_event records-stored-locally

# The app reads /data/records.json and writes /data/result.json; stdout is the diagnostic fallback.
# Capped to the secure-rads enclave allocation (1 vCPU / 2048 MiB) so both trees get the same compute.
docker run --rm --cpus {{.CPUCount}} --memory {{.MemoryMiB}}m -v "$RUN_DIR:/data" -e RECORDS_PATH=/data/records.json -e RESULT_PATH=/data/result.json "$IMAGE" > "$OUTPUT_FILE"
# DSAR trail: log the data subjects only after the DC app produced a result. Best-effort.
if [ -s "$RESULT_FILE" ]; then
  printf '%s' "$SUBJECT_IDS" | "$TOOLS_BIN" subject-access "https://$LOG_HOST/subject-access" "$ALGORITHM_ID" "$RUN_ID" || true
fi
emit_event compute-completed
