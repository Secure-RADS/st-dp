#!/bin/bash
set -euo pipefail
dnf install -y docker
systemctl enable --now docker
usermod -aG docker ec2-user

# docker-compose-plugin isn't in the AL2023 default repo; standalone binary instead.
curl -SL https://github.com/docker/compose/releases/latest/download/docker-compose-linux-aarch64 \
  -o /usr/local/bin/docker-compose
chmod +x /usr/local/bin/docker-compose
ln -s /usr/local/bin/docker-compose /usr/libexec/docker/cli-plugins/docker-compose 2>/dev/null || \
  (mkdir -p /usr/libexec/docker/cli-plugins && ln -s /usr/local/bin/docker-compose /usr/libexec/docker/cli-plugins/docker-compose)

# Compose + unit are injected at `make deploy` from repo files (see scripts/render_cfn.py).
install -d -o ec2-user -g ec2-user /home/ec2-user/registry-service
cat > /home/ec2-user/registry-service/docker-compose.yml <<'COMPOSE'
@@DOCKER_COMPOSE@@
COMPOSE
chown ec2-user:ec2-user /home/ec2-user/registry-service/docker-compose.yml

cat > /etc/systemd/system/csav-registry.service <<'UNIT'
@@SYSTEMD_UNIT@@
UNIT
systemctl daemon-reload
systemctl enable csav-registry.service
